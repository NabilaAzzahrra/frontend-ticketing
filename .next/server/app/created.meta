{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/created/layout,_N_T_/(app)/created/page,_N_T_/created"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/created/__PAGE__",
    "/!KGFwcCk/created",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}