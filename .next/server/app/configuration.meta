{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/configuration/layout,_N_T_/(app)/configuration/page,_N_T_/configuration"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/configuration/__PAGE__",
    "/!KGFwcCk/configuration",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}