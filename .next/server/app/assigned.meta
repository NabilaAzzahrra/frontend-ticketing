{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/assigned/layout,_N_T_/(app)/assigned/page,_N_T_/assigned"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/assigned/__PAGE__",
    "/!KGFwcCk/assigned",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}