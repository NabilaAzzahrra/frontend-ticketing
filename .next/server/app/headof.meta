{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/headof/layout,_N_T_/(app)/headof/page,_N_T_/headof"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/headof/__PAGE__",
    "/!KGFwcCk/headof",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}